#!/bin/sh
# Refuse commits that would publish secrets or personal details.
# Enabled for the dotfiles repository through `core.hooksPath` (see install.zsh).
#
# Every check fails closed: a missing scanner or pattern file stops the commit
# instead of waving it through. This hook is the last thing between a secret and
# a public repository, and a check that silently does nothing is worse than none,
# because it still reads as a check.

# The tools the checks need, up front rather than at each use: a grep that cannot
# run would leave the set of added lines empty, and an empty set reads exactly
# like "nothing here to object to".
for tool in git grep awk; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "pre-commit: $tool is missing, so the staged changes went unchecked." >&2
    exit 1
  }
done
if ! command -v gitleaks >/dev/null 2>&1; then
  echo 'pre-commit: gitleaks is missing, so the staged changes went unscanned.' >&2
  echo 'NixOS: nixos/base.nix installs it. macOS: the Brewfile does.' >&2
  echo 'Debian: apt install gitleaks, or a release from github.com/gitleaks/gitleaks.' >&2
  exit 1
fi

# Binary files next, before the early exit below: the other checks read added
# lines, and a binary file contributes none, so a keyring, an editor's state file
# or a .p12 added with `git add -f` would pass all of them unseen.
binaries=$(git diff --cached --numstat --diff-filter=AM |
  awk '$1 == "-" && $2 == "-" { print $3 }')
if [ -n "$binaries" ]; then
  printf 'pre-commit: these staged files are binary, and nothing here can read them:\n%s\n' "$binaries" >&2
  echo 'Commit with --no-verify only if you have checked them yourself.' >&2
  exit 1
fi

added=$(git diff --cached --no-color -U0 | grep '^+' | grep -v '^+++')
[ -n "$added" ] || exit 0

# Secrets that look the same everywhere
if printf '%s\n' "$added" | grep -Eq 'gh[pousr]_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}|glpat-[A-Za-z0-9_-]{20}|xox[abprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|(^|[^A-Za-z0-9_-])sk-[A-Za-z0-9_-]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY( BLOCK)?-----'; then
  echo "pre-commit: the staged changes contain what looks like a secret." >&2
  exit 1
fi

# Personal details: extended regular expressions, one per line and case-insensitive,
# kept in a file outside the repository. Lines starting with "!" allow text that the
# other patterns would block, such as e-mail addresses that are public anyway.
patterns="$HOME/.config/dotfiles/private-patterns"
if [ ! -r "$patterns" ]; then
  echo "pre-commit: $patterns is missing, so personal details went unchecked." >&2
  echo 'Create it; an empty file is how you say this machine needs no patterns.' >&2
  exit 1
fi
found=$(printf '%s\n' "$added" | awk -v file="$patterns" '
  BEGIN {
    while ((getline line < file) > 0) {
      if (line == "" || line ~ /^#/) continue
      if (line ~ /^!/) allow[++allows] = tolower(substr(line, 2))
      else deny[++denies] = tolower(line)
    }
  }
  {
    text = tolower($0)
    for (i = 1; i <= allows; i++) gsub(allow[i], "", text)
    for (i = 1; i <= denies; i++) if (text ~ deny[i]) { print; next }
  }')
if [ -n "$found" ]; then
  printf 'pre-commit: these staged lines match a pattern in %s:\n%s\n' "$patterns" "$found" >&2
  exit 1
fi

# A dedicated scanner, for the shapes the patterns above do not know
gitleaks protect --staged --redact --no-banner || exit 1
