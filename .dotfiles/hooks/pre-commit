#!/bin/sh
# Refuse commits that would publish secrets or personal details.
# Enabled for the dotfiles repository through `core.hooksPath` (see install.zsh).
#
# Every check fails closed: a missing scanner or pattern file stops the commit
# instead of waving it through. This hook is the last thing between a secret and
# a public repository, and a check that silently does nothing is worse than none,
# because it still reads as a check.

# The tools the checks need, up front rather than at each use: a grep that cannot
# run would leave the set of added lines empty, and an empty set reads exactly
# like "nothing here to object to".
for tool in git grep awk; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "pre-commit: $tool is missing, so the staged changes went unchecked." >&2
    exit 1
  }
done
if ! command -v gitleaks >/dev/null 2>&1; then
  echo 'pre-commit: gitleaks is missing, so the staged changes went unscanned.' >&2
  echo 'NixOS: nixos/base.nix installs it. macOS: the Brewfile does.' >&2
  echo 'Other Linux: dotfiles-update installs it through Nix (see the README), or apt install gitleaks.' >&2
  exit 1
fi

# The identity and the signature this commit would carry. Both are wrong only in
# ways that show up late: weeks later on a machine whose update refuses to pull an
# unsigned commit, or as "Unverified" on a commit whose address the key does not
# carry. A clone made by hand, or one whose ~/.gitconfig.local went missing, signs
# nothing and says nothing about it.
if [ "$(git config --get commit.gpgsign)" != "true" ]; then
  echo 'pre-commit: commit.gpgsign is not true in this repository, so this commit would be unsigned.' >&2
  echo 'Set it here: git config commit.gpgsign true' >&2
  exit 1
fi
signingkey=$(git config --get user.signingkey)
if [ -z "$signingkey" ]; then
  echo 'pre-commit: user.signingkey is empty, so git has no key to sign with.' >&2
  echo "Set it in ~/.gitconfig.local, to this machine's signing subkey." >&2
  exit 1
fi
# Only OpenPGP keys carry the user IDs that the address is compared with
gpgformat=$(git config --get gpg.format)
if [ -z "$gpgformat" ] || [ "$gpgformat" = "openpgp" ]; then
  if ! command -v gpg >/dev/null 2>&1; then
    echo 'pre-commit: gpg is missing, so the signing key went unchecked.' >&2
    exit 1
  fi
  # ${signingkey%!} drops the ! that pins git to one subkey; gpg looks up the key itself
  committer=$(git var GIT_COMMITTER_IDENT | sed -n 's/.*<\(.*\)>.*/\1/p')
  uids=$(gpg --list-keys --with-colons "${signingkey%!}" 2>/dev/null |
    awk -F: '$1 == "uid" { print $10 }' | sed -n 's/.*<\(.*\)>.*/\1/p')
  if ! printf '%s\n' "$uids" | grep -Fqix "$committer"; then
    echo "pre-commit: $committer is not a user ID on the signing key ${signingkey%!}." >&2
    echo 'GitHub shows such a commit as Unverified. Either add the address to the key' >&2
    echo 'with gpg --quick-add-uid, or commit under an address the key carries:' >&2
    printf '%s\n' "$uids" | sed 's/^/  /' >&2
    exit 1
  fi
fi

# Which paths may be committed at all. The work tree is the home directory, so the
# allow-list in ~/.gitignore decides what shows up in `git status` -- and an ignore
# rule is a filter, not a guard: a path the allow-list does not cover yet, or one
# added with `git add -f`, travels on the next commit without anything objecting.
toplevel=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$toplevel" ]; then
  echo 'pre-commit: no work tree here, so the staged paths went unchecked.' >&2
  exit 1
fi
allowed="$toplevel/.dotfiles/allowed-paths"
[ -r "$allowed" ] || allowed="$toplevel/.allowed-paths"
if [ ! -r "$allowed" ]; then
  echo "pre-commit: no allowed-paths file under $toplevel, so the staged paths went unchecked." >&2
  echo 'Create .dotfiles/allowed-paths, or .allowed-paths: one path pattern per line.' >&2
  exit 1
fi
# zsh keeps a pattern held in a variable literal unless this is set, and would
# then refuse every path. Not reached under sh, where setopt does not exist.
[ -n "${ZSH_VERSION:-}" ] && setopt glob_subst 2> /dev/null

# Deletions need no permission; ACMR is what the commit would add or change.
refused=$(git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r path; do
  ok=0
  while IFS= read -r pattern; do
    case "$pattern" in '' | \#*) continue ;; esac
    # $pattern unquoted on purpose: it is a glob, and * spans / as well
    case "$path" in $pattern) ok=1; break ;; esac
  done < "$allowed"
  [ "$ok" -eq 1 ] || printf '%s\n' "$path"
done)
if [ -n "$refused" ]; then
  printf 'pre-commit: these staged paths are not in %s:\n%s\n' "$allowed" "$refused" >&2
  echo 'When such a path belongs in the repository, add its pattern to that file in this same commit.' >&2
  exit 1
fi

# Binary files next, before the early exit below: the other checks read added
# lines, and a binary file contributes none, so a keyring, an editor's state file
# or a .p12 added with `git add -f` would pass all of them unseen.
binaries=$(git diff --cached --numstat --diff-filter=AM |
  awk '$1 == "-" && $2 == "-" { print $3 }')
if [ -n "$binaries" ]; then
  printf 'pre-commit: these staged files are binary, and nothing here can read them:\n%s\n' "$binaries" >&2
  echo 'Commit with --no-verify only if you have checked them yourself.' >&2
  exit 1
fi

added=$(git diff --cached --no-color -U0 | grep '^+' | grep -v '^+++')
[ -n "$added" ] || exit 0

# Secrets that look the same everywhere
if printf '%s\n' "$added" | grep -Eq 'gh[pousr]_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}|glpat-[A-Za-z0-9_-]{20}|xox[abprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|(^|[^A-Za-z0-9_-])sk-[A-Za-z0-9_-]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY( BLOCK)?-----'; then
  echo "pre-commit: the staged changes contain what looks like a secret." >&2
  exit 1
fi

# Personal details: extended regular expressions, one per line and case-insensitive,
# kept in a file outside the repository. Lines starting with "!" allow text that the
# other patterns would block, such as e-mail addresses that are public anyway.
patterns="$HOME/.config/dotfiles/private-patterns"
if [ ! -r "$patterns" ]; then
  echo "pre-commit: $patterns is missing, so personal details went unchecked." >&2
  echo 'Create it; an empty file is how you say this machine needs no patterns.' >&2
  exit 1
fi
found=$(printf '%s\n' "$added" | awk -v file="$patterns" '
  BEGIN {
    while ((getline line < file) > 0) {
      if (line == "" || line ~ /^#/) continue
      if (line ~ /^!/) allow[++allows] = tolower(substr(line, 2))
      else deny[++denies] = tolower(line)
    }
  }
  {
    text = tolower($0)
    for (i = 1; i <= allows; i++) gsub(allow[i], "", text)
    for (i = 1; i <= denies; i++) if (text ~ deny[i]) { print; next }
  }')
if [ -n "$found" ]; then
  printf 'pre-commit: these staged lines match a pattern in %s:\n%s\n' "$patterns" "$found" >&2
  exit 1
fi

# A dedicated scanner, for the shapes the patterns above do not know.
# gitleaks 8.19 renamed `protect --staged` to `git --staged`. The old name still
# works as a deprecated alias in 8.30, but Ubuntu 24.04's package is 8.16, which
# predates the rename, and a gitleaks 9 that drops the alias would otherwise block
# every commit. So ask this machine's version which one it has, newest name first.
if gitleaks git --help >/dev/null 2>&1; then
  gitleaks git --staged --redact --no-banner || exit 1
else
  gitleaks protect --staged --redact --no-banner || exit 1
fi
