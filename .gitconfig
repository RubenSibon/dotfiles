[core]
	excludesFile = ~/.dotfiles/.gitignore_global
	fsmonitor = true
	untrackedCache = true

[init]
	defaultBranch = main
# Replay local commits on top of the remote ones, instead of a merge commit per pull
[pull]
	rebase = true
[rebase]
	autoStash = true
[push]
	autoSetupRemote = true
[rerere]
	enabled = true
	autoUpdate = true

[alias]
	hist = log --pretty=format:'%C(yellow)[%ad]%C(reset) %C(green)[%h]%C(reset) | %C(red)%s %C(bold red){{%an}}%C(reset) %C(blue)%d%C(reset)' --graph --date=short
# Machine-specific settings, such as [user], [includeIf] and the git-lfs filter, stay out of the dotfiles repo
[include]
	path = ~/.gitconfig.local

