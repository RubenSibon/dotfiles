[
  {
    "key": "ctrl+shift+/",
    "command": "workbench.action.closeSidebar"
  },
  // Chat input
  {
    "args": {
      "text": "\n"
    },
    "command": "default:type",
    "key": "enter",
    "when": "chatInputHasFocus"
  },
  {
    "args": {
      "text": "\n"
    },
    "command": "default:type",
    "key": "alt+enter",
    "when": "chatInputHasFocus"
  },
  {
    "args": {
      "text": "\n"
    },
    "command": "default:type",
    "key": "shift+enter",
    "when": "chatInputHasFocus"
  },
  {
    "command": "-workbench.action.chat.submitWithCodebase",
    "key": "ctrl+enter",
    "when": "chatInputHasFocus"
  },
  {
    "command": "workbench.action.chat.submit",
    "key": "ctrl+enter",
    "when": "chatInputHasFocus && chatInputHasSendableContent"
  },
  // Editor utilities
  {
    "command": "writeTimestamp.perform",
    "key": "shift+alt+t",
    "when": "editorTextFocus"
  },
  {
    "command": "-writeTimestamp.perform",
    "key": "ctrl+shift+t",
    "when": "editorTextFocus"
  },
  // Merge editor
  {
    "command": "mergeEditor.toggleBetweenInputs",
    "key": "ctrl+alt+t",
    "when": "isMergeEditor"
  },
  {
    "command": "-mergeEditor.toggleBetweenInputs",
    "key": "ctrl+shift+t",
    "when": "isMergeEditor"
  },
  // Terminal: send shift+enter as ESC+CR, the only way a terminal program can tell
  // it from a bare enter. Claude Code binds it to a newline; without this it submits.
  // What /terminal-setup writes by hand, kept here so no update removes it again.
  {
    "args": {
      "text": "\u001b\r"
    },
    "command": "workbench.action.terminal.sendSequence",
    "key": "shift+enter",
    "when": "terminalFocus"
  }
]